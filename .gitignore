# Ignore Python cache files (speeds up execution but shouldn't be tracked)
__pycache__/
*.py[cod]
*.so

# Ignore Virtual Environments (where your packages live)
.venv/
venv/
ENV/

# Ignore environment variables and secrets (NEVER share passwords or keys!)
.env
.env.local

# Ignore OS generated files
.DS_Store
Thumbs.db